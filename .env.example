# Association Web — переменные окружения.
# Скопируйте в .env.local и заполните значения. Секреты не коммитятся.

# Публичный URL приложения (без слэша на конце)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Секрет Better Auth: минимум 32 случайных символа
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Секрет HMAC для псевдонимных id авторов вкладов в админ-модерации.
# В production обязателен: смена секрета меняет все псевдонимы.
MODERATION_PSEUDONYM_SECRET=replace-with-a-long-random-secret

# Origin мобильного приложения (Expo scheme), можно несколько через запятую
APP_MOBILE_ORIGIN=association://

# Реквизиты оператора ПДн (самозанятый): заполните до публикации.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_CONTACT_EMAIL=support@mnemoslov.ru

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/association

# Почта через SMTP NetAngels (mail.netangels.ru).
# Порт 465 — TLS, 587 — STARTTLS. SMTP_SECURE=true для 465.
SMTP_HOST=mail.netangels.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@example.com
SMTP_PASS=replace-with-mailbox-password
EMAIL_FROM="Мнемослов <support@example.com>"

# ЮKassa. Без ключей создание платежей возвращает BILLING_NOT_CONFIGURED.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Необязательный список IP webhook через запятую; пусто — проверка отключена.
YOOKASSA_TRUSTED_IPS=
