# Association Web — переменные окружения.
# Скопируйте в .env.local и заполните значения. Секреты не коммитятся.

# Публичный URL приложения (без слэша на конце)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Секрет Better Auth: минимум 32 случайных символа
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/association

# Почта (Resend). Без ключей письма не отправляются.
RESEND_API_KEY=
EMAIL_FROM=Association <no-reply@example.com>

# ЮKassa. Без ключей создание платежей возвращает BILLING_NOT_CONFIGURED.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Необязательный список IP webhook через запятую; пусто — проверка отключена.
YOOKASSA_TRUSTED_IPS=
